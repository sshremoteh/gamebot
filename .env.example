# Telegram Bot Token (получить у @BotFather в Telegram)
BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# Настройки базы данных
DB_PATH=gamebot.db

# Стартовый баланс для новых игроков
STARTING_BALANCE=10000

# Минимальная ставка
MIN_BET=10

# Максимальная ставка (0 - без ограничений, ограничена балансом)
MAX_BET=1000000
